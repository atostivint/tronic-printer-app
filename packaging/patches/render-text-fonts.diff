+/// The font file called `name` (any case) in the font folders. On Windows that is one lookup in
+/// `Fonts`; elsewhere the folders are walked once (a few levels deep) and remembered.
+fn find_font(name: &str) -> Option<std::path::PathBuf> {
+    if cfg!(windows) {
+        return font_dirs().into_iter().map(|d| d.join(name)).find(|p| p.is_file());
+    }
+    static INDEX: OnceLock<Vec<(String, std::path::PathBuf)>> = OnceLock::new();
+    let index = INDEX.get_or_init(|| {
+        fn walk(dir: &std::path::Path, depth: usize, out: &mut Vec<(String, std::path::PathBuf)>) {
+            let Ok(entries) = std::fs::read_dir(dir) else { return };
+            for e in entries.flatten() {
+                let path = e.path();
+                if path.is_dir() {
+                    if depth > 0 {
+                        walk(&path, depth - 1, out);
+                    }
+                } else if let Some(n) = path.file_name().and_then(|n| n.to_str()) {
+                    out.push((n.to_ascii_lowercase(), path));
+                }
+            }
+        }
+        let mut out = Vec::new();
+        for dir in font_dirs() {
+            walk(&dir, 4, &mut out);
+        }
+        out
+    });
+    let wanted = name.to_ascii_lowercase();
+    index.iter().find(|(n, _)| *n == wanted).map(|(_, p)| p.clone())
 }
 
