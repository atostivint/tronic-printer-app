<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Tronic Printer</string>
    <key>CFBundleDisplayName</key>
    <string>Tronic Printer</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.tronic-printer</string>
    <key>CFBundleExecutable</key>
    <string>tronic-printer</string>
    <key>CFBundleIconFile</key>
    <string>icon</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleVersion</key>
    <string>@VERSION@</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Without this key macOS kills the app the moment it touches Bluetooth. -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Tronic Printer uses Bluetooth to find your Tronic Mini Pocket Printer and send it your prints.</string>
</dict>
</plist>
